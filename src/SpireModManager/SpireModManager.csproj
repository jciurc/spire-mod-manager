<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SpireModManager</AssemblyName>
    <RootNamespace>SpireModManager</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The API (src/SpireModManager/Api, the only public types): other mods bind to this assembly by name and this
         version, and the game matches it strictly, so it stays 1.0.0.0 for good; the release's own version is the
         InformationalVersion build.cs passes in. Every public member has a doc comment (CS1591 fails the build), and
         the public surface is recorded in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt: adding, changing or
         removing a public member without recording it fails the build too (docs/dev/API.md). -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The reference assembly (the public surface, no code) beside the dll: build.cs hands it to dependents with its dist option. -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;RS0016;RS0017;RS0024;RS0025;RS0026;RS0027;RS0036;RS0037</WarningsAsErrors>
    <!-- build.cs and tools/dev.cs find the Steam library that has the game and pass it in. Building any
         other way (an IDE, a plain dotnet build) uses STS2_STEAMAPPS, else the first of Steam's default
         folder and the SteamLibrary folder Steam suggests at a drive's root that has the game: if yours is
         somewhere else, set STS2_STEAMAPPS to that library's steamapps folder (README.md). -->
    <SteamLibrary Condition="'$(SteamLibrary)' == ''">$(STS2_STEAMAPPS)</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2')">C:\Program Files (x86)\Steam\steamapps</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == '' And Exists('D:\SteamLibrary\steamapps\common\Slay the Spire 2')">D:\SteamLibrary\steamapps</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == '' And Exists('E:\SteamLibrary\steamapps\common\Slay the Spire 2')">E:\SteamLibrary\steamapps</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == '' And Exists('F:\SteamLibrary\steamapps\common\Slay the Spire 2')">F:\SteamLibrary\steamapps</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == ''">C:\Program Files (x86)\Steam\steamapps</SteamLibrary>
    <GameData>$(SteamLibrary)\common\Slay the Spire 2\data_sts2_windows_x86_64</GameData>
  </PropertyGroup>

  <!-- The Workshop build (build.cs sets SpireModManagerWorkshop for its dist option) holds only what players
       run: no in-game self-test, no dev-run switches, and no debug information (which would carry this
       machine's paths). Every other build has the DEVTOOLS code. -->
  <PropertyGroup Condition="'$(SpireModManagerWorkshop)' != 'true'">
    <DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpireModManagerWorkshop)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(SpireModManagerWorkshop)' == 'true'">
    <Compile Remove="SelfTest.cs" />
    <Compile Remove="SelfTest.Api.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build time only: checks the public surface against the PublicAPI files; nothing of it ships. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameData)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameData)\GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameData)\0Harmony.dll" Private="false" />
    <Reference Include="Steamworks.NET" HintPath="$(GameData)\Steamworks.NET.dll" Private="false" />
    <!-- The game's text formatter, to check drop-in translations format as the game does (Translations). -->
    <Reference Include="SmartFormat" HintPath="$(GameData)\SmartFormat.dll" Private="false" />
  </ItemGroup>

</Project>
