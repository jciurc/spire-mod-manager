<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>SpireModManager</AssemblyName>
    <RootNamespace>SpireModManager</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- build.cs and tools/dev.cs find the Steam library that has the game and pass it in. Building any
         other way (an IDE, a plain dotnet build) uses STS2_STEAMAPPS, else Steam's default folder: if the
         game is in another library, set STS2_STEAMAPPS to that library's steamapps folder (README.md). -->
    <SteamLibrary Condition="'$(SteamLibrary)' == ''">$(STS2_STEAMAPPS)</SteamLibrary>
    <SteamLibrary Condition="'$(SteamLibrary)' == ''">C:\Program Files (x86)\Steam\steamapps</SteamLibrary>
    <GameData>$(SteamLibrary)\common\Slay the Spire 2\data_sts2_windows_x86_64</GameData>
  </PropertyGroup>

  <!-- The Workshop build (build.cs sets Dist for its dist option) holds only what players run: no in-game self-test, no
       dev-run switches, and no debug information (which would carry this machine's paths). Every other
       build has the DEVTOOLS code. -->
  <PropertyGroup Condition="'$(Dist)' != 'true'">
    <DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Dist)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup Condition="'$(Dist)' == 'true'">
    <Compile Remove="SelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameData)\sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameData)\GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameData)\0Harmony.dll" Private="false" />
    <Reference Include="Steamworks.NET" HintPath="$(GameData)\Steamworks.NET.dll" Private="false" />
  </ItemGroup>

</Project>
