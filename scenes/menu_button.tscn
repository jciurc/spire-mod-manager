; The Get Mods button from the vanilla Modding screen (NModMenuButton, same art, font and hover),
; except the art is a 9-slice so the button can be wider than the texture's aspect ratio.
; Visuals/Image stays a TextureRect because NModMenuButton reads it and animates its shader;
; it draws nothing itself, and Frame inherits its material. Frame's size and scale are set in code.
[node name="SpireModManagerButton" type="Control"]
layout_mode = 3
anchors_preset = 0
offset_right = 170.0
offset_bottom = 70.0
